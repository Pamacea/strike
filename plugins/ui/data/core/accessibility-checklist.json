{
  "version": "1.1.0",
  "description": "Accessibility checklist for strike implementer validation",

  "checklist": {
    "semantic_structure": {
      "name": "Semantic HTML Structure",
      "priority": "critical",
      "checks": [
        {
          "id": "semantic_heading",
          "description": "Use proper heading hierarchy (h1-h6)",
          "test": "Exactly one h1, headings in order, no skipped levels",
          "wcag_reference": "1.3.1"
        },
        {
          "id": "semantic_landmarks",
          "description": "Use landmark elements (nav, main, article, section, aside, footer)",
          "test": "Page has identifiable regions",
          "wcag_reference": "1.3.1"
        },
        {
          "id": "semantic_lists",
          "description": "Use proper list elements (ul, ol, dl)",
          "test": "Lists of items use list markup, not divs",
          "wcag_reference": "1.3.1"
        },
        {
          "id": "semantic_buttons",
          "description": "Use button for actions, anchor for navigation",
          "test": "Buttons are <button>, links are <a> with href",
          "wcag_reference": "1.3.1"
        }
      ]
    },
    "keyboard_navigation": {
      "name": "Keyboard Accessibility",
      "priority": "critical",
      "checks": [
        {
          "id": "tab_order",
          "description": "Logical tab order",
          "test": "Tab follows visual order, all interactive focusable",
          "wcag_reference": "2.4.3"
        },
        {
          "id": "focus_visible",
          "description": "Visible focus indicator",
          "test": "Focus state clearly visible (not just color change)",
          "wcag_reference": "2.4.7"
        },
        {
          "id": "keyboard_traps",
          "description": "No keyboard traps",
          "test": "User can tab in and out of all areas",
          "wcag_reference": "2.1.2"
        },
        {
          "id": "shortcuts",
          "description": "Keyboard shortcuts documented",
          "test": "Custom shortcuts documented and can be disabled",
          "wcag_reference": "2.1.4"
        }
      ]
    },
    "aria_attributes": {
      "name": "ARIA Attributes",
      "priority": "high",
      "checks": [
        {
          "id": "aria_labels",
          "description": "Proper aria-labels on interactive elements",
          "test": "Icon buttons have aria-label, landmark labels meaningful",
          "wcag_reference": "2.4.6"
        },
        {
          "id": "aria_live",
          "description": "Live regions for dynamic content",
          "test": "Status updates use aria-live or role='status'",
          "wcag_reference": "4.1.3"
        },
        {
          "id": "aria_hidden",
          "description": "Proper use of aria-hidden",
          "test": "Not used on focusable content, only decorative",
          "wcag_reference": "4.1.2"
        },
        {
          "id": "aria_expanded",
          "description": "Expanded state on toggle elements",
          "test": "Collapsible content has aria-expanded",
          "wcag_reference": "4.1.2"
        }
      ]
    },
    "color_contrast": {
      "name": "Color and Contrast",
      "priority": "critical",
      "checks": [
        {
          "id": "contrast_normal",
          "description": "Normal text contrast (WCAG AA: 4.5:1)",
          "test": "Body text meets 4.5:1 contrast ratio - verify with automated tool",
          "wcag_reference": "1.4.3",
          "note": "WCAG AA requires 4.5:1 for normal text (below 18pt/24px or 14pt bold/20px)",
          "automated_check": true,
          "tools": ["axe-core", "pa11y", "WAVE"]
        },
        {
          "id": "contrast_large",
          "description": "Large text contrast (WCAG AA: 3:1)",
          "test": "Text 18pt+ or 14pt bold meets 3:1",
          "wcag_reference": "1.4.3",
          "note": "WCAG AA requires 3:1 for large text (18pt/24px or 14pt bold/20px and above)",
          "automated_check": true
        },
        {
          "id": "contrast_ui",
          "description": "UI component contrast (WCAG AA: 3:1)",
          "test": "Borders, focus indicators meet 3:1",
          "wcag_reference": "1.4.11",
          "note": "WCAG AA requires 3:1 for UI components and graphical objects",
          "automated_check": true
        },
        {
          "id": "not_color_only",
          "description": "Don't rely on color alone",
          "test": "Info conveyed with color also has non-color indicator",
          "wcag_reference": "1.4.1"
        }
      ]
    },
    "images_media": {
      "name": "Images and Media",
      "priority": "high",
      "checks": [
        {
          "id": "alt_text",
          "description": "Meaningful alt text for images",
          "test": "Informative images have alt, decorative alt=''",
          "wcag_reference": "1.1.1"
        },
        {
          "id": "alt_not_filename",
          "description": "Alt text is descriptive, not filename",
          "test": "Alt describes content/purpose, not 'image.jpg'",
          "wcag_reference": "1.1.1"
        },
        {
          "id": "media_controls",
          "description": "Media has accessible controls",
          "test": "Audio/video has controls, not autoplay",
          "wcag_reference": "1.4.2"
        }
      ]
    },
    "forms": {
      "name": "Form Accessibility",
      "priority": "critical",
      "checks": [
        {
          "id": "labels_associated",
          "description": "Labels properly associated with inputs",
          "test": "Each input has matching label via for/id",
          "wcag_reference": "1.3.1"
        },
        {
          "id": "required_indicated",
          "description": "Required fields programmatically indicated",
          "test": "Required attribute, not just visual asterisk",
          "wcag_reference": "3.3.2"
        },
        {
          "id": "errors_announced",
          "description": "Errors announced to screen readers",
          "test": "Error summary with aria-live, inline errors in aria-describedby",
          "wcag_reference": "3.3.1"
        },
        {
          "id": "instructions_available",
          "description": "Form instructions available",
          "test": "Format, constraints explained before input",
          "wcag_reference": "3.3.2"
        }
      ]
    },
    "motion": {
      "name": "Motion and Animation",
      "priority": "medium",
      "checks": [
        {
          "id": "prefers_reduced_motion",
          "description": "Respects prefers-reduced-motion",
          "test": "Animations respect user's motion preference",
          "wcag_reference": "2.3.3"
        },
        {
          "id": "no_flashing",
          "description": "No flashing content",
          "test": "Nothing flashes more than 3 times/second",
          "wcag_reference": "2.3.1"
        },
        {
          "id": "animation_duration",
          "description": "Animation duration limits",
          "test": "Animations under 5 seconds, or user can disable",
          "wcag_reference": "2.3.3",
          "note": "Long animations should respect prefers-reduced-motion"
        },
        {
          "id": "no_seizure_triggers",
          "description": "No seizure-inducing patterns",
          "test": "No rapid strobing, red flash sequences, or alternating patterns",
          "wcag_reference": "2.3.1",
          "note": "Check for 3 flashes/second limit and general flash/red flash thresholds"
        },
        {
          "id": "safe_easing",
          "description": "Safe easing functions",
          "test": "Avoid jarring or bouncy easing that could cause discomfort",
          "wcag_reference": "2.3.2",
          "note": "Linear or ease-out preferred over ease-in-out for motion"
        }
      ]
    },
    "screen_reader": {
      "name": "Screen Reader Experience",
      "priority": "high",
      "checks": [
        {
          "id": "content_order",
          "description": "Content order makes sense when read",
          "test": "Reading order matches visual order",
          "wcag_reference": "1.3.2"
        },
        {
          "id": "hidden_visual",
          "description": "Screen reader only content available",
          "test": "sr-only class used for visual-hidden content",
          "wcag_reference": "1.3.1"
        },
        {
          "id": "page_title",
          "description": "Descriptive page title",
          "test": "Each page has unique, descriptive title",
          "wcag_reference": "2.4.2"
        },
        {
          "id": "landmark_labels",
          "description": "Landmarks have meaningful labels",
          "test": "Navigation, main, and other landmarks have aria-label or unique heading",
          "wcag_reference": "2.4.1",
          "note": "Multiple landmarks need labels to distinguish them"
        },
        {
          "id": "empty_state_described",
          "description": "Empty states are announced",
          "test": "Empty lists, tables, and containers have aria-label or text description",
          "wcag_reference": "4.1.3",
          "note": "Screen reader should know why content is empty"
        },
        {
          "id": "live_region_priority",
          "description": "Live regions use appropriate priority",
          "test": "Status uses polite, errors use assertive, not both for same content",
          "wcag_reference": "4.1.3",
          "note": "Polite waits for user pause, assertive interrupts immediately"
        },
        {
          "id": "dynamic_content_announced",
          "description": "Dynamic content changes are announced",
          "test": "New messages, errors, updates use aria-live or role='status/alert'",
          "wcag_reference": "4.1.3"
        },
        {
          "id": "focus_management_dialogs",
          "description": "Dialog focus properly managed",
          "test": "Focus moves into dialog, returns to trigger on close",
          "wcag_reference": "2.4.3",
          "note": "Test with actual screen reader to confirm focus trap"
        }
      ]
    },
    "forms_validation": {
      "name": "Form Validation Accessibility",
      "priority": "critical",
      "checks": [
        {
          "id": "errors_announced_inline",
          "description": "Inline errors announced with input",
          "test": "Each error linked via aria-describedby to its input",
          "wcag_reference": "3.3.1"
        },
        {
          "id": "error_summary_visible",
          "description": "Error summary at form top",
          "test": "Summary with aria-live='assertive' lists all errors on submit",
          "wcag_reference": "3.3.1"
        },
        {
          "id": "validation_messages_clear",
          "description": "Validation messages are specific",
          "test": "Error explains what's wrong and how to fix",
          "wcag_reference": "3.3.1"
        },
        {
          "id": "required_explained",
          "description": "Required fields clearly indicated",
          "test": "Required attribute plus visible indicator before the label",
          "wcag_reference": "3.3.2"
        }
      ]
    },
    "keyboard_traps": {
      "name": "Keyboard Trap Prevention",
      "priority": "critical",
      "checks": [
        {
          "id": "modal_focus_trap",
          "description": "Modals trap focus properly",
          "test": "Tab cycles within modal, escape closes and returns focus",
          "wcag_reference": "2.1.2"
        },
        {
          "id": "custom_widgets_keyboard",
          "description": "Custom widgets are keyboard accessible",
          "test": "All custom components work with keyboard, not just mouse/touch",
          "wcag_reference": "2.1.1"
        },
        {
          "id": "no_focus_traps",
          "description": "No accidental focus traps",
          "test": "User can always tab out of any component",
          "wcag_reference": "2.1.2"
        },
        {
          "id": "focus_returns",
          "description": "Focus returns after dismiss",
          "test": "Closing menus, dialogs, dropdowns returns focus to trigger",
          "wcag_reference": "2.4.3"
        }
      ]
    }
  },

  "constraint_specific_overrides": {
    "screen_reader_first": {
      "priority_override": "all_critical",
      "additional_checks": [
        "Test with actual screen reader (NVDA/VoiceOver)",
        "Verify all interactions work without mouse",
        "Confirm visual content is appropriately described"
      ]
    },
    "print_first": {
      "additional_checks": [
        "No hover-dependent information",
        "All content available without interaction",
        "Print styles hide unnecessary UI elements"
      ]
    },
    "css_only": {
      "additional_checks": [
        "All functionality works without JavaScript",
        "Form submissions use native browser behavior",
        "State changes use CSS :checked or :focus"
      ]
    }
  }
}
